# ADB (Android Debug Bridge) Yapılandırması
ADB_HOST=127.0.0.1
EMULATOR_PORT=5555

# Saldırı Tespit Sistemi (IDS / Detector) Yapılandırması
# detector.py tarafında kullanılacak log seviyesi (DEBUG, INFO, WARNING, ERROR)
DETECTOR_LOG_LEVEL=INFO

# Logcat çıktılarının veya log dosyasının taranacağı konum
# Boş bırakılırsa detector doğrudan adb shell üzerinden canlı logcat okumaya çalışır
LOGCAT_SOURCE_PATH=

# Algılanacak kritik kelimelerin listesi (virgülle ayrılmış)
DETECTION_KEYWORDS=SIGSEGV,SIGABRT,died,has died
